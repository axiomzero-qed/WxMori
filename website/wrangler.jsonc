{
  "name": "wxmori",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "wxmori.com", "custom_domain": true },
    { "pattern": "www.wxmori.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
